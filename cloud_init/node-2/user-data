#cloud-config
hostname: node-2
fqdn: node-2
preserve_hostname: false

ssh_pwauth: false

users:
  - name: student
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: false
    passwd: "$6$BfDo0D9j/oGmKqxF$ADQPst3EzRuzoGJbGqHkk2kk.BMQRXgco8c6GaGxF4XkQDyZbE2cA39ZFV635aPV8tTr560uMYohtyQkOVMFP/"
    sudo: "ALL=(ALL) ALL"
    ssh_authorized_keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPRr8iRcu8B4JPZC7bebQqwQ3re/uXxWQHJBmY8bfaMe student@laptop"
  - name: app
    shell: /usr/sbin/nologin
    lock_passwd: true

write_files:
  - path: /etc/docker/daemon.json
    content: |
      {
        "log-driver": "json-file",
        "log-opts": {"max-size": "10m", "max-file": "3"}
      }
  - path: /etc/apt/sources.list.d/docker.sources
    content: |
      Types: deb
      URIs: https://download.docker.com/linux/debian
      Suites: trixie
      Components: stable
      Signed-By: /etc/apt/keyrings/docker.asc

runcmd:
  # 1. Ждём сеть
  - sh -c 'until ping -c1 -W2 8.8.8.8 >/dev/null 2>&1; do sleep 2; done'
  # 2. Ставим базовые пакеты (перенесено из блока packages)
  - apt-get update
  - apt-get install -y ufw ca-certificates curl git
  # 3. Docker
  - install -m 0755 -d /etc/apt/keyrings
  - sh -c 'curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc'
  - chmod a+r /etc/apt/keyrings/docker.asc
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - usermod -aG docker student
  # 4. Firewall
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow from 192.168.56.12
  - ufw allow 22/tcp
  - ufw allow 80,443/tcp
  - ufw --force enable